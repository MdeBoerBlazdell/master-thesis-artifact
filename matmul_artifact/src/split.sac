// My experiments to explain chapter on implementation
// of mm in sac.

/* To go from i, j, k to i, k, j on the outer level */

#define M0B  32
#define K0B  40
#define N0B  10

#define M1B  3
#define K1B  1
#define N1B  125

#define M2B  15
#define K2B  1
#define N2B  1

#define M3B  6
#define K3B  250
#define N3B  8

#define N   (N0B * N1B * N2B * N3B)
#define M   (M0B * M1B * M2B * M3B)
#define K   (K0B * K1B * K2B * K3B)


use Array: all;
use StdIO: all;
use Benchmarking: all;

import Shapely: all;


external double[M3B, N3B]
matmul(
    double[M0B, K0B, M1B, K1B, M2B, K2B, M3B, K3B] a,
    double[K0B, N0B, K1B, N1B, K2B, N2B, K3B, N3B] b,
    int offset_a,
    int offset_b
);

#pragma linkobj "./kernel.o"
#pragma linksign [1,2,3,4,5]
#pragma linkname "matmul"


#define ASZS M0B, K0B, M1B, K1B, M2B, K2B, M3B, K3B
#define BSZS K0B, N0B, K1B, N1B, K2B, N2B, K3B, N3B


inline
int row_major(int[.] iv, int[.] shp)
{
    return sum({
        [i] -> iv[i] * prod(drop([i + 1], shp))
    });
}


/*
 * Level 0.
 *
 * ia : int[0]
 * ib : int[0]
 *
 * Result shape:
 * [M0B,N0B,M1B,N1B,M2B,N2B,M3B,N3B]
 */
inline
double[M0B, N0B,
       M1B, N1B,
       M2B, N2B,
       M3B, N3B]
mmy(
    double[ASZS] a,
    int[0] ia,
    double[BSZS] b,
    int[0] ib
)
{
    return {
        [i,j] ->
            with {
                ([0] <= [l] < [K0B]) :
                    mmy2(
                        a,
                        [i,l],

                        b,
                        [l,j]
                    );
            }
            : fold(
                +,
                genarray(
                    [M1B, N1B,
                     M2B, N2B,
                     M3B, N3B],
                    0d
                )
            )

        | [i,j] < [M0B,N0B]
    };
}


/*
 * Level 1.
 *
 * ia = [m0,k0]
 * ib = [k0,n0]
 *
 * Result shape:
 * [M1B,N1B,M2B,N2B,M3B,N3B]
 */
inline
double[M1B, N1B,
       M2B, N2B,
       M3B, N3B]
mmy2(
    double[ASZS] a,
    int[2] ia,
    double[BSZS] b,
    int[2] ib
)
{
    return {
        [i,j] ->
            with {
                ([0] <= [l] < [K1B]) :
                    mmy4(
                        a,
                        [ia[0], ia[1],
                         i,     l],

                        b,
                        [ib[0], ib[1],
                         l,     j]
                    );
            }
            : fold(
                +,
                genarray(
                    [M2B, N2B,
                     M3B, N3B],
                    0d
                )
            )

        | [i,j] < [M1B,N1B]
    };
}


/*
 * Level 2.
 *
 * ia = [m0,k0,m1,k1]
 * ib = [k0,n0,k1,n1]
 *
 * Result shape:
 * [M2B,N2B,M3B,N3B]
 */
inline
double[M2B, N2B,
       M3B, N3B]
mmy4(
    double[ASZS] a,
    int[4] ia,
    double[BSZS] b,
    int[4] ib
)
{
    return {
        [i,j] ->
            with {
                ([0] <= [l] < [K2B]) :
                    mmy6(
                        a,
                        [ia[0], ia[1],
                         ia[2], ia[3],
                         i,     l],

                        b,
                        [ib[0], ib[1],
                         ib[2], ib[3],
                         l,     j]
                    );
            }
            : fold(
                +,
                genarray(
                    [M3B,N3B],
                    0d
                )
            )

        | [i,j] < [M2B,N2B]
    };
}


/*
 * Level 3 / leaf.
 *
 * ia = [m0,k0,m1,k1,m2,k2]
 * ib = [k0,n0,k1,n1,k2,n2]
 *
 * The last two coordinates are zero because the external
 * matmul kernel handles the M3/K3/N3 dimensions itself.
 */
inline
double[M3B,N3B]
mmy6(
    double[ASZS] a,
    int[6] ia,
    double[BSZS] b,
    int[6] ib
)
{
    iva =
        [ia[0], ia[1],
         ia[2], ia[3],
         ia[4], ia[5],
         0,     0];

    ivb =
        [ib[0], ib[1],
         ib[2], ib[3],
         ib[4], ib[5],
         0,     0];

    /*
     * row_major is inlined, 3 * 12 flops on
     * 2 * 5 * 250 * 8 flops for the kernel,
     * so a ratio of about 0.002.
     */
    return matmul(
        a,
        b,
        row_major(iva, [ASZS]),
        row_major(ivb, [BSZS])
    );
}


noinline
double[*] id(double[*] a)
{
    return a;
}


int main()
{
    iblocked = getInterval("blocked", 1);
    itiling = getInterval("tiling", 2);
    iuntiling = getInterval("untiling", 3);

    a = reshape(
        [M,K],
        tod(iota(M * K))
    );

    b = reshape(
        [K,N],
        tod(iota(K * N))
    );


    start(itiling);

    a1 = reshape(
        [M0B, M1B, M2B, M3B,
         K0B, K1B, K2B, K3B],
        a
    );

    b1 = reshape(
        [K0B, K1B, K2B, K3B,
         N0B, N1B, N2B, N3B],
        b
    );

    /*
     * Calling mmy.
     */
    a2 = preblock(a1);
    b2 = preblock(b1);

    end(itiling);


    time, unit = returnResultUnit(itiling);
    tile_time = time;


    start(iblocked);

    c = mmy(a2, [], b2, []);

    end(iblocked);


    time, unit = returnResultUnit(iblocked);
    mul_time = time;


    start(iuntiling);

    c = reshape(
        [M,N],
        unpreblock(c)
    );

    end(iuntiling);


    time, unit = returnResultUnit(iuntiling);
    untile_time = time;


    printf(
        "%lf,%lf,%lf",
        tile_time,
        mul_time,
        untile_time
    );

    return toi(sum(c));
}