module Shapely;
export all;

use Array:all;
use StdIO:all;

// This is stdlib-like functions that are not yet
// found in the standard library.

// The length of a vector
inline int
len(int[.] xs) {
  return shape(xs)[0];
}

inline int[*], int[*]
takedrop(int[*] s, int d) {
  return (take([d], s), drop([d], s));
}

// permute the elements in `v` using permutation `pv`
inline int[.]
permute (int[.] pv, int[.] v)
{
  return {iv -> v[pv[iv]] | iv < shape(v) };
}

// permutate elements of `v` using *inverse* permutation `pv`.
inline int[.]
invpermute (int[.] pv, int[.] v)
{
    res = v;
    for(i = 0; i < len(pv); i++)
        res[pv[i]] = v[i];
    return res;
}


// Use *inverse* permutation of the shape vector
// to tranpose the array `a`.
inline double[*]
ptranspose (int[.] pv, double[*] a)
{
  return { iv -> a[invpermute(pv, iv)] 
         | iv < permute (pv, shape(a))};
}

// Flatten in row-major order
inline int[.]
flatten(int[*] a) {
  return reshape([prod(shape (a))], a);
}

// flatten . transpose
inline int[.]
flattrans(int[*] a) {
  return flatten(transpose(a));
}


// Matmul-related functions that

// [a b c d e f] ~> [[a b][c d][e f]]
inline int[.,.]
into_pairs(int[.] s) {
  return reshape([len(s)/2,2], s);
}

// [a b c d e f] ~> [[a b c ][d e f]]
inline int[.,.]
into_halves(int[.] s) {
  return reshape([2,len(s)/2], s);
}

inline double[*]
preblock(double[*] a) {
    mask = flattrans(into_halves(iota(dim(a))));
    return ptranspose(mask, a);
}

// X[x,u, y,v, z,w] => X[x,y,z, u,v,w]
inline double[*]
unpreblock(double[*] a) {
    mask = flattrans(into_pairs(iota(dim(a))));
    return ptranspose(mask, a);
}

// Append a length-2 index onto a statically-known index vector, returning a
// concretely-typed result. This side-steps the built-in `++` (_cat_VxV_),
// whose result length is currently mis-inferred (int[L] ++ int[R] -> int[L]).
// Overloaded by the length of the left operand so every call site gets a
// statically known length and dispatches to the right block level.
inline int[2]
cat2(int[0] v, int[2] w) {
  return [w[0], w[1]];
}
inline int[4]
cat2(int[2] v, int[2] w) {
  return [v[0], v[1], w[0], w[1]];
}
inline int[6]
cat2(int[4] v, int[2] w) {
  return [v[0], v[1], v[2], v[3], w[0], w[1]];
}

// mmshape [M,K] [K,N] ~> [M,N]
inline int[2]
mmshape(int[2] m, int[2] n) {
  return [m[0], n[1]];
}

// map the above function to pairs
// [m1 k1  m2 k2  ... ] [k1 n1  k2 n2  ... ] ~> [m1 n1  m2 n2 ... ]
inline int[.]
mmshape(int[.] m, int[.] n) {
  pm = into_pairs(m);
  pn = into_pairs(n);
  return flatten({[i] -> mmshape(pm[i], pn[i])});
}

// [x xs y ys] into_halves [[x xs],[y,ys]]
// [x,xs,y,ys] => [x,y, xs,ys]
double[*]
block (double[*] a) {
  ijs, ivs = takedrop(transpose(into_halves(iota(dim(a)))), 1);
  return ptranspose(flatten(ijs) ++ flattrans(ivs), a);
}

// [x,y,xs,ys] => [x,xs,y,ys]
double[*]
unblock (double[*] a) {
  ijs, ivs = takedrop(iota(dim(a)), 2);
  return ptranspose(flattrans([ijs] ++ transpose(into_halves(ivs))), a);
}
